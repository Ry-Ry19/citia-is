# .env.example (project root — the Next.js frontend)
#
# Copy the lines you need into .env.local (git-ignored), then restart
# `npm run dev`. Never put real credentials in this file.

# Address of the CITIA-IS FastAPI service, used by the Identify scanner,
# the Report a Sighting form, and (server-side) the staff sign-in check.
# NEXT_PUBLIC_ values are copied into the JavaScript sent to every
# browser, so this must only ever be a public address — never a key,
# password or secret.
#
#   Same computer:           http://localhost:8000
#   Phone on the same Wi-Fi: http://<this computer's LAN IP>:8000
#     Also add http://<LAN IP>:3000 to CORS_ORIGINS in backend/.env and
#     start the API with:  uvicorn main:app --host 0.0.0.0 --port 8000
#
# Run the two services separately: the API from backend/ (see
# backend/README.md) and the frontend with `npm run dev` from here.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── CENRO staff sign-in (Supabase Auth) ───────────────────────────────
# See docs/ADMIN_AUTH_SETUP.md. These have NO NEXT_PUBLIC_ prefix: they
# are used only by the Next.js server, never sent to the browser.
#
# Project URL and the PUBLISHABLE key (Dashboard → Settings → API Keys).
# Never put the secret / service_role key here.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable key>

# Signs the cookie that limits a staff session to 8 hours. At least 32
# characters; generate one with the command in docs/ADMIN_AUTH_SETUP.md.
SESSION_SECRET=<random secret>

# ADMIN_EMAIL and ADMIN_PASSWORD_HASH belonged to the old single-account
# sign-in, which has been removed. Delete them from .env.local.
