# backend/.env.example
#
# Copy this file to backend/.env and adjust the values for your machine.
# backend/.env is git-ignored. Never put real credentials in this file.

# "development" enables the interactive API docs at http://localhost:8000/docs.
# Use "production" on the deployed server.
ENVIRONMENT=development

# Frontend origins allowed to call the API from a browser, comma-separated.
# When testing from a phone on your network, add your LAN address,
# for example: http://localhost:3000,http://192.168.1.239:3000
# Never use "*".
CORS_ORIGINS=http://localhost:3000

# Trained YOLOv8n-cls weights. A relative path is read from the backend/
# folder. The file is git-ignored and must come from the project's own
# training run — never from an untrusted source.
WEIGHTS_PATH=models/mahogany_cls.pt

# PROVISIONAL low-confidence threshold (0–100). Results below it are
# flagged so the community member is asked for a clearer photo. Confirm
# this value against the model's evaluation results before finalising.
LOW_CONFIDENCE_THRESHOLD=70

# Upload limits: largest file in bytes (10 MB) and largest resolution
# in pixels, width x height (50 megapixels).
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=50000000

# Name of the trained model, saved with every AI result (for example
# mahogany_cls-v1). Required: without it AI classification stays
# unavailable, even if the weights file exists.
MODEL_VERSION=

# ── Database (Supabase PostgreSQL) ─────────────────────────────────────
# Optional. Leave empty and the API still runs; /health then reports the
# database as "not_configured".
#
# Connect as the least-privilege citia_api role through the Session
# pooler (IPv4, port 5432). The user name is citia_api.<project-ref>.
# Never use the postgres owner account here: the API refuses to use a
# connection that is not citia_api. If the password contains special
# characters, percent-encode them (for example @ becomes %40).
#
#   postgresql://citia_api.<project-ref>:<password>@<pooler-host>:5432/postgres
DATABASE_URL=

# Supabase's root certificate (Dashboard → Database settings → SSL
# configuration → Download certificate). It is public, not a secret.
# The connection always uses sslmode=verify-full, so the API connects
# only if the server proves it is really your Supabase database.
DATABASE_SSL_ROOT_CERT=certs/supabase-root.crt

# Connection pool size and time limits. The defaults suit the Free plan.
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=4
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ── Supabase Auth ──────────────────────────────────────────────────────
# Project URL, used later to verify CENRO staff access tokens with the
# project's public keys. Not a secret.
SUPABASE_URL=https://<project-ref>.supabase.co

# ── Supabase Storage (S3 protocol) ─────────────────────────────────────
# Report photos are stored here. From Dashboard → Storage → S3 settings.
# Until all four are set, POST /reports answers 503.
#
# The access keys reach ALL of this project's Storage and bypass its
# RLS. Paste them only into backend/.env; never give them a NEXT_PUBLIC_
# prefix.
#
#   https://<project-ref>.storage.supabase.co/storage/v1/s3
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# The private bucket for report photos. Create it with Public OFF.
STORAGE_BUCKET=sighting-photos
